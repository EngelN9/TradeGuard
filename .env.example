# Safe local defaults only. Never put a real credential in this file.
TRADEGUARD_ENV=research
TRADEGUARD_LOG_LEVEL=INFO
TRADEGUARD_RUN_CONNECTED_TESTS=0
TRADEGUARD_CONNECTED_PROVIDER=disabled
# Leave empty. Supply a data-only key through the process environment only
# after ADR 0002 prerequisites and connected-session review are complete.
TRADEGUARD_TWELVE_DATA_API_KEY=

# Local Docker Compose database only; replace outside local development.
TRADEGUARD_POSTGRES_DB=tradeguard
TRADEGUARD_POSTGRES_USER=tradeguard_app
TRADEGUARD_POSTGRES_PASSWORD=local-development-only
