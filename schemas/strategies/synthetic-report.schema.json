      "type": "string"
    },
    "strategy_version_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Strategy Version Hash",
      "type": "string"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "warning": {
      "const": "Synthetic offline research only; not investment advice or promotion evidence.",
      "default": "Synthetic offline research only; not investment advice or promotion evidence.",
      "title": "Warning",
      "type": "string"
    }
  },
  "required": [
    "strategy_id",
    "strategy_version_hash",
    "dataset_manifest_checksum",
    "output_events",
    "planned_orders",
    "fills",
    "conserved",
    "first_decision_time_utc",
    "first_fill_time_utc",
    "holding_at_end",
    "backtest_result_checksum",
    "report_checksum"
