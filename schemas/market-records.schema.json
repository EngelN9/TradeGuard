{
  "$defs": {
    "OHLCVBar": {
      "additionalProperties": false,
      "description": "Time-bounded OHLCV observation.",
      "properties": {
        "asset_class": {
          "enum": [
            "equity",
            "crypto"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "close_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Close Price"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "high_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "High Price"
        },
        "ingest_time_utc": {
          "format": "date-time",
          "title": "Ingest Time Utc",
          "type": "string"
        },
        "interval_end_utc": {
          "format": "date-time",
          "title": "Interval End Utc",
          "type": "string"
        },
        "interval_start_utc": {
          "format": "date-time",
          "title": "Interval Start Utc",
          "type": "string"
        },
        "low_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Low Price"
        },
        "open_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Open Price"
        },
        "record_type": {
          "const": "bar",
          "default": "bar",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        },
        "source": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Volume"
        }
      },
      "required": [
        "source",
        "asset_class",
        "venue",
        "symbol",
        "event_time_utc",
        "ingest_time_utc",
        "sequence_number",
        "interval_start_utc",
        "interval_end_utc",
        "open_price",
        "high_price",
        "low_price",
        "close_price",
        "volume"
      ],
      "title": "OHLCVBar",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "description": "Best bid and ask observation.\n\nCrossed quotes and invalid numeric values remain representable so the\nquality gate can quarantine the original observation without rewriting it.",
