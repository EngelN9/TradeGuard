        "asset_class",
        "venue",
        "symbol",
        "event_time_utc",
        "ingest_time_utc",
        "sequence_number",
        "trade_id",
        "price",
        "quantity"
      ],
      "title": "Trade",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "bar": "#/$defs/OHLCVBar",
      "quote": "#/$defs/Quote",
      "trade": "#/$defs/Trade"
    },
    "propertyName": "record_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Quote"
    },
    {
      "$ref": "#/$defs/Trade"
    },
    {
      "$ref": "#/$defs/OHLCVBar"
    }
  ]
