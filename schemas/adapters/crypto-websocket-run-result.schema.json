{
  "$defs": {
    "AssetClass": {
      "description": "Supported event asset-class labels.",
      "enum": [
        "equity",
        "crypto",
        "system"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "DataCorrection": {
      "additionalProperties": false,
      "properties": {
        "affected_range": {
          "$ref": "#/$defs/DataInterval"
        },
        "corrected_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corrected Checksum",
          "type": "string"
        },
        "correction_id": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Correction Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "previous_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Previous Checksum",
          "type": "string"
        }
      },
      "required": [
        "correction_id",
        "description",
        "known_at",
        "affected_range",
        "previous_checksum",
        "corrected_checksum"
      ],
      "title": "DataCorrection",
      "type": "object"
    },
    "DataInterval": {
      "additionalProperties": false,
      "properties": {
        "end_utc": {
          "format": "date-time",
          "title": "End Utc",
          "type": "string"
        },
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        }
      },
      "required": [
        "start_utc",
        "end_utc"
      ],
      "title": "DataInterval",
      "type": "object"
    },
    "DataQualityAlert": {
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "event_type": {
          "const": "DataQualityAlert",
          "default": "DataQualityAlert",
          "title": "Event Type",
          "type": "string"
        },
        "ingest_time_utc": {
          "format": "date-time",
          "title": "Ingest Time Utc",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "payload_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Checksum",
          "type": "string"
        },
        "quarantined": {
          "title": "Quarantined",
          "type": "boolean"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "source",
        "asset_class",
        "venue",
        "symbol",
        "event_time_utc",
        "ingest_time_utc",
        "sequence_number",
        "correlation_id",
        "run_id",
        "payload_checksum",
        "code",
        "severity",
        "message",
        "quarantined"
      ],
      "title": "DataQualityAlert",
      "type": "object"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "description": "Complete identity, provenance, and quality context for one dataset.",
      "properties": {
        "asset_class": {
          "enum": [
            "equity",
            "crypto"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "checksums": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 2048,
            "minLength": 1
          },
          "title": "Checksums",
          "type": "object"
        },
        "corrections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataCorrection"
          },
          "title": "Corrections",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "date_range": {
          "$ref": "#/$defs/DataInterval"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "licensing_notes": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Licensing Notes",
          "type": "string"
        },
        "missing_intervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MissingInterval"
          },
          "title": "Missing Intervals",
          "type": "array"
        },
        "parent_dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParentDataset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "partition_information": {
          "items": {
            "$ref": "#/$defs/DatasetPartition"
          },
          "minItems": 1,
          "title": "Partition Information",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "symbols": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Symbols",
          "type": "array"
        },
        "transformation_graph": {
          "$ref": "#/$defs/TransformationGraph"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "source",
        "asset_class",
        "symbols",
        "date_range",
        "row_count",
        "partition_information",
        "checksums",
        "created_at",
        "ingested_at",
        "licensing_notes"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "DatasetPartition": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "date_range": {
          "$ref": "#/$defs/DataInterval"
        },
        "partition_id": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Partition Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "partition_id",
        "relative_path",
        "row_count",
        "date_range",
        "checksum"
      ],
      "title": "DatasetPartition",
      "type": "object"
    },
    "MissingInterval": {
      "additionalProperties": false,
      "properties": {
        "date_range": {
          "$ref": "#/$defs/DataInterval"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "date_range",
        "reason"
      ],
      "title": "MissingInterval",
      "type": "object"
    },
    "ParentDataset": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "manifest_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Checksum",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "manifest_checksum"
      ],
      "title": "ParentDataset",
      "type": "object"
    },
    "QualityCode": {
      "enum": [
        "missing",
        "duplicate",
        "out_of_order",
        "future_timestamp",
        "stale_content",
        "invalid_ohlc",
        "negative_volume",
        "abnormal_price_jump",
        "inconsistent_schema",
        "symbol_mapping_conflict",
        "trading_session_violation",
        "half_day_handling",
        "corporate_action_mismatch",
        "corporate_actions_unsupported",
        "suspected_unmodeled_corporate_action",
        "split_discontinuity",
        "delisted_symbol_handling",
        "point_in_time_universe_violation",
        "crypto_24_7_gap",
        "precision_mismatch",
        "minimum_notional_mismatch",
        "venue_maintenance_interval",
        "bid_greater_than_ask",
        "spread_anomaly",
        "quote_asset_inconsistency"
      ],
      "title": "QualityCode",
      "type": "string"
    },
    "QualityIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/QualityCode"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "record_indexes": {
          "default": [],
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Record Indexes",
          "type": "array"
        },
        "status": {
          "enum": [
            "WARN",
            "FAIL",
            "QUARANTINED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "message"
      ],
      "title": "QualityIssue",
      "type": "object"
    },
    "QualityReport": {
      "additionalProperties": false,
      "description": "Checksummed result bound to a specific dataset manifest.",
      "properties": {
        "dataset_id": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/QualityIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "manifest_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Checksum",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QualityStatus"
        }
      },
      "required": [
        "dataset_id",
        "manifest_checksum",
        "evaluated_at",
        "status",
        "issues"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "QUARANTINED"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "Quote": {
      "additionalProperties": false,
      "description": "Best bid and ask observation.\n\nCrossed quotes and invalid numeric values remain representable so the\nquality gate can quarantine the original observation without rewriting it.",
      "properties": {
        "ask_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ask Price"
        },
        "ask_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ask Quantity"
        },
        "asset_class": {
          "enum": [
            "equity",
            "crypto"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "bid_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Bid Price"
        },
        "bid_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Bid Quantity"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "ingest_time_utc": {
          "format": "date-time",
          "title": "Ingest Time Utc",
          "type": "string"
        },
        "quote_asset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Asset"
        },
        "record_type": {
          "const": "quote",
          "default": "quote",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        },
        "source": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "source",
        "asset_class",
        "venue",
        "symbol",
        "event_time_utc",
        "ingest_time_utc",
        "sequence_number",
        "bid_price",
        "ask_price",
        "bid_quantity",
        "ask_quantity"
      ],
      "title": "Quote",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StreamState": {
      "enum": [
        "CONNECTING",
        "SUBSCRIBING",
        "TRADABLE",
        "NOT_TRADABLE",
        "STOPPED"
      ],
      "title": "StreamState",
      "type": "string"
    },
    "Trade": {
      "additionalProperties": false,
      "description": "Individual trade observation.",
      "properties": {
        "asset_class": {
          "enum": [
            "equity",
            "crypto"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "ingest_time_utc": {
          "format": "date-time",
          "title": "Ingest Time Utc",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "quote_asset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Asset"
        },
        "record_type": {
          "const": "trade",
          "default": "trade",
          "title": "Record Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        },
        "source": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "trade_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Trade Id",
          "type": "string"
        },
        "venue": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "source",
        "asset_class",
        "venue",
        "symbol",
        "event_time_utc",
        "ingest_time_utc",
        "sequence_number",
        "trade_id",
        "price",
        "quantity"
      ],
      "title": "Trade",
      "type": "object"
    },
    "TransformationGraph": {
      "additionalProperties": false,
      "description": "Immutable directed acyclic transformation graph.",
      "properties": {
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TransformationStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "title": "TransformationGraph",
      "type": "object"
    },
    "TransformationStep": {
      "additionalProperties": false,
      "description": "One versioned transformation from one or more datasets to one dataset.",
      "properties": {
        "implementation_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "input_dataset_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Dataset Ids",
          "type": "array"
        },
        "operation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "output_dataset_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Output Dataset Id",
          "type": "string"
        },
        "parameters_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "transformation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Transformation Id",
          "type": "string"
        }
      },
      "required": [
        "transformation_id",
        "operation",
        "implementation_version",
        "input_dataset_ids",
        "output_dataset_id",
        "parameters_hash"
      ],
      "title": "TransformationStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/DataQualityAlert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "backoff_seconds": {
      "items": {
        "type": "number"
      },
      "title": "Backoff Seconds",
      "type": "array"
    },
    "clean_shutdown": {
      "title": "Clean Shutdown",
      "type": "boolean"
    },
    "final_state": {
      "$ref": "#/$defs/StreamState"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatasetManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "messages_received": {
      "maximum": 20,
      "minimum": 0,
      "title": "Messages Received",
      "type": "integer"
    },
    "product_id": {
      "const": "BTC-USD",
      "default": "BTC-USD",
      "title": "Product Id",
      "type": "string"
    },
    "provider": {
      "const": "coinbase_advanced_trade",
      "default": "coinbase_advanced_trade",
      "title": "Provider",
      "type": "string"
    },
    "quality_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualityReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_message_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Raw Message Sha256",
      "type": "array"
    },
    "raw_payload_published": {
      "const": false,
      "default": false,
      "title": "Raw Payload Published",
      "type": "boolean"
    },
    "raw_payload_retained": {
      "const": false,
      "default": false,
      "title": "Raw Payload Retained",
      "type": "boolean"
    },
    "reconnect_count": {
      "maximum": 3,
      "minimum": 0,
      "title": "Reconnect Count",
      "type": "integer"
