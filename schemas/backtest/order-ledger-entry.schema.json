{
  "$defs": {
    "OrderStatus": {
      "enum": [
        "submitted",
        "partially_filled",
        "filled",
        "rejected",
        "unfilled",
        "blocked"
      ],
      "title": "OrderStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "filled_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": 0,
      "title": "Filled Quantity"
    },
    "order_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Order Id",
      "type": "string"
    },
    "reasons": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "remaining_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": 0,
      "title": "Remaining Quantity"
    },
    "requested_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "gt": 0,
      "title": "Requested Quantity"
    },
    "status": {
      "$ref": "#/$defs/OrderStatus"
    }
  },
  "required": [
    "order_id",
    "status",
    "requested_quantity",
    "filled_quantity",
    "remaining_quantity"
  ],
  "title": "OrderLedgerEntry",
  "type": "object"
}
