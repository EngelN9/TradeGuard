{
  "$defs": {
    "BacktestResult": {
      "additionalProperties": false,
      "properties": {
        "conservation": {
          "$ref": "#/$defs/ConservationReport"
        },
        "corporate_actions": {
          "items": {
            "$ref": "#/$defs/CorporateActionLedgerEntry"
          },
          "title": "Corporate Actions",
          "type": "array"
        },
        "dataset_manifest_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Manifest Checksum",
          "type": "string"
        },
        "ending_asset_balances": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": 0
          },
          "propertyNames": {
            "maxLength": 512,
            "minLength": 1
          },
          "title": "Ending Asset Balances",
          "type": "object"
        },
        "ending_currency_balances": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": 0
          },
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 512,
            "minLength": 1
          },
          "title": "Ending Currency Balances",
          "type": "object"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/FillLedgerEntry"
          },
          "title": "Fills",
          "type": "array"
        },
        "orders": {
          "items": {
            "$ref": "#/$defs/OrderLedgerEntry"
          },
          "title": "Orders",
          "type": "array"
        },
        "plan_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Checksum",
          "type": "string"
        },
        "pnl_series": {
          "items": {
            "$ref": "#/$defs/PnLLedgerEntry"
          },
          "minItems": 1,
          "title": "Pnl Series",
          "type": "array"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/PositionLedgerEntry"
          },
          "title": "Positions",
          "type": "array"
        },
        "result_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Checksum",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "run_identity": {
          "$ref": "#/$defs/BacktestRunIdentity"
        },
        "run_type": {
          "enum": [
            "backtest",
            "replay"
          ],
          "title": "Run Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1.0",
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "run_type",
        "run_identity",
        "plan_checksum",
        "dataset_manifest_checksum",
        "orders",
        "fills",
        "corporate_actions",
        "positions",
        "pnl_series",
        "ending_asset_balances",
        "ending_currency_balances",
        "conservation",
        "warnings",
        "result_checksum"
      ],
      "title": "BacktestResult",
      "type": "object"
    },
    "BacktestRunIdentity": {
      "additionalProperties": false,
      "description": "Reproducible manifest identity bound into the deterministic result.",
      "properties": {
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "cost_model_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Cost Model Version",
          "type": "string"
        },
        "dataset_manifests": {
          "items": {
            "$ref": "#/$defs/DatasetManifestReference"
          },
          "minItems": 1,
          "title": "Dataset Manifests",
          "type": "array"
        },
        "date_range": {
          "$ref": "#/$defs/RunDateRange"
        },
        "dependency_lock_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Hash",
          "type": "string"
        },
        "dirty_worktree": {
          "title": "Dirty Worktree",
          "type": "boolean"
        },
        "execution_model_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Execution Model Version",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        },
        "universe": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Universe",
          "type": "array"
        }
      },
      "required": [
        "strategy_id",
        "strategy_version",
        "git_sha",
        "dirty_worktree",
        "config_hash",
        "dataset_manifests",
        "date_range",
        "universe",
        "random_seed",
        "dependency_lock_hash",
        "cost_model_version",
        "execution_model_version"
      ],
      "title": "BacktestRunIdentity",
      "type": "object"
    },
    "ConservationReport": {
      "additionalProperties": false,
      "properties": {
        "asset_quantity_differences": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Asset Quantity Differences",
          "type": "object"
        },
        "cash_equity_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cash Equity Difference"
        },
        "conserved": {
          "title": "Conserved",
          "type": "boolean"
        },
        "duplicate_fill_ids_ignored": {
          "minimum": 0,
          "title": "Duplicate Fill Ids Ignored",
          "type": "integer"
        }
      },
      "required": [
        "cash_equity_difference",
        "asset_quantity_differences",
        "duplicate_fill_ids_ignored",
        "conserved"
      ],
      "title": "ConservationReport",
      "type": "object"
    },
    "CorporateActionLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "action_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Checksum",
          "type": "string"
        },
        "action_type": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "cash_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cash Delta"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "quantity_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Quantity After"
        },
        "quantity_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Quantity Before"
        },
        "symbol_after": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol After",
          "type": "string"
        },
        "symbol_before": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol Before",
          "type": "string"
        }
      },
      "required": [
        "action_checksum",
        "symbol_before",
        "symbol_after",
        "action_type",
        "effective_at",
        "quantity_before",
        "quantity_after",
        "cash_delta"
      ],
      "title": "CorporateActionLedgerEntry",
      "type": "object"
    },
    "CostBreakdown": {
      "additionalProperties": false,
      "description": "Explicit costs charged in the account's quote currency.",
      "properties": {
        "commission": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Commission"
        },
        "market_impact": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Market Impact"
        },
        "slippage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Slippage"
        },
        "spread": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Spread"
        },
        "tax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Tax"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Total"
        }
      },
      "required": [
        "commission",
        "tax",
        "spread",
        "slippage",
        "market_impact",
        "total"
      ],
      "title": "CostBreakdown",
      "type": "object"
    },
    "DatasetManifestReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "checksum"
      ],
      "title": "DatasetManifestReference",
      "type": "object"
    },
    "FillLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "enum": [
            "equity",
            "crypto"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "costs": {
          "$ref": "#/$defs/CostBreakdown"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "fill_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fill Id",
          "type": "string"
        },
        "order_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "order_type": {
          "$ref": "#/$defs/OrderType"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Price"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Quantity"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "symbol": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "fill_id",
        "order_id",
        "asset_class",
        "venue",
        "symbol",
        "side",
        "order_type",
        "event_time_utc",
        "price",
        "quantity",
        "costs"
      ],
      "title": "FillLedgerEntry",
      "type": "object"
    },
    "OrderLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "filled_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Filled Quantity"
        },
        "order_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "remaining_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Remaining Quantity"
        },
        "requested_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Requested Quantity"
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        }
      },
      "required": [
        "order_id",
        "status",
        "requested_quantity",
        "filled_quantity",
        "remaining_quantity"
      ],
      "title": "OrderLedgerEntry",
      "type": "object"
    },
    "OrderStatus": {
      "enum": [
        "submitted",
        "partially_filled",
        "filled",
        "rejected",
        "unfilled",
        "blocked"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "market",
        "limit"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "PnLLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "cash": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Cash"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "market_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Market Value"
        },
        "realized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Realized Pnl"
        },
        "total_equity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Total Equity"
        },
        "total_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Pnl"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Unrealized Pnl"
        }
      },
      "required": [
        "event_time_utc",
        "cash",
        "market_value",
        "realized_pnl",
        "unrealized_pnl",
        "total_pnl",
        "total_equity"
      ],
      "title": "PnLLedgerEntry",
      "type": "object"
    },
    "PositionLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "enum": [
            "equity",
            "crypto"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "average_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Average Cost"
        },
        "event_time_utc": {
          "format": "date-time",
          "title": "Event Time Utc",
          "type": "string"
        },
        "mark_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Mark Price"
        },
        "market_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Market Value"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Quantity"
        },
        "symbol": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Unrealized Pnl"
        },
        "venue": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "event_time_utc",
        "asset_class",
        "venue",
        "symbol",
        "quantity",
        "average_cost",
        "mark_price",
        "market_value",
        "unrealized_pnl"
      ],
      "title": "PositionLedgerEntry",
      "type": "object"
    },
    "RunDateRange": {
      "additionalProperties": false,
      "properties": {
        "end_utc": {
          "format": "date-time",
          "title": "End Utc",
          "type": "string"
        },
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        }
      },
      "required": [
        "start_utc",
        "end_utc"
      ],
      "title": "RunDateRange",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "description": "Complete, immutable run identity and reproducibility record.",
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "cost_model_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Cost Model Version",
          "type": "string"
        },
        "dataset_manifests": {
          "items": {
            "$ref": "#/$defs/DatasetManifestReference"
          },
          "minItems": 1,
          "title": "Dataset Manifests",
          "type": "array"
        },
        "date_range": {
          "$ref": "#/$defs/RunDateRange"
        },
        "dependency_lock_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Hash",
          "type": "string"
        },
        "dirty_worktree": {
          "title": "Dirty Worktree",
          "type": "boolean"
        },
        "execution_model_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Execution Model Version",
          "type": "string"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Sha",
          "type": "string"
        },
        "platform": {
